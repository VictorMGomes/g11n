{
    "name": "victormgomes/g11n",
    "description": "All-in-one globalization for Laravel",
    "keywords": [
        "Victor M. Gomes",
        "laravel",
        "g11n"
    ],
    "homepage": "https://github.com/victormgomes/g11n",
    "license": "MIT",
    "authors": [
        {
            "name": "Victor M. Gomes",
            "email": "info@victormgomes.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "pragmarx/countries": "^1.0.2",
        "propaganistas/laravel-phone": "^6.0.3",
        "akaunting/laravel-money": "^6.0.3"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.1.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Victormgomes\\G11n\\": "src/",
            "Victormgomes\\G11n\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Victormgomes\\G11n\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Victormgomes\\G11n\\G11nServiceProvider"
            ],
            "aliases": {
                "G11n": "Victormgomes\\G11n\\Facades\\G11n"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
